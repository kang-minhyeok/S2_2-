package org.tukorea.guardhub.controller;

import org.springframework.stereotype.Controller;
import org.springframework.ui.Model;
import org.springframework.web.bind.annotation.GetMapping;
import org.springframework.web.bind.annotation.PathVariable;
import org.springframework.web.bind.annotation.RequestMapping;

import java.util.HashMap;
import java.util.Map;

@Controller
@RequestMapping("/notice")
public class NoticeController {

	// 1. 공지사항 목록 페이지 (/notice)
	@GetMapping
	public String noticeList(Model model) {
		// TODO: 실제 DB 연동 시 NoticeService를 통해 리스트를 가져와서 model에 추가하세요.
		// model.addAttribute("noticeList", noticeService.findAll());

		return "notice"; // templates/notice.html 매핑
	}

	// 2. 공지사항 상세 페이지 (/notice/detail/{id})
	@GetMapping("/detail/{id}")
	public String noticeDetail(@PathVariable("id") Long id, Model model) {
		// DB 연동 전 화면 테스트를 위한 임시 dummy 데이터 설정
		Map<String, Object> dummyNotice = new HashMap<>();
		dummyNotice.put("id", id);
		dummyNotice.put("title", "시스템 정기 점검 및 업데이트 안내 (" + id + "번 공지)");
		dummyNotice.put("writer", "관리자");
		dummyNotice.put("regDate", "2026-03-13");
		dummyNotice.put("content", "가드허브 시스템 안정화를 위한 정기 점검이 진행될 예정입니다.\n점검 시간 동안 서비스 이용이 일시 중지될 수 있으니 양해 부탁드립니다.");
		dummyNotice.put("hasCctv", false); // 필요 시 CCTV 버튼 표시 여부

		model.addAttribute("notice", dummyNotice);

		return "notice_detail"; // templates/notice_detail.html 매핑
	}
}
